# URL of the Agent-Hub FastAPI backend. Defaults to http://localhost:8000.
# Auth endpoints live at /api/auth/* and /api/me; HR data lives under /api/v1.
NEXT_PUBLIC_AGENT_API=http://localhost:8000

# Dev-only fallback identity. Used as the X-User-Email header before a user has
# signed in (and by the local Azure AD mock). In a real session the logged-in
# user's email + Bearer token are sent automatically. Must match a user that
# exists in the backend's Postgres users table.
NEXT_PUBLIC_HR_USER_EMAIL=dev@agamxts.com

# NOTE: Authentication is handled by the backend.
#   - Auth0 passwordless email OTP (external users): send-otp -> verify-otp
#   - Microsoft Entra / Azure AD (internal users): via Azure Static Web Apps
# No Auth0/Azure client secrets are needed in the frontend.

# ── PostHog product analytics ────────────────────────────────────────────────
# Project API key from PostHog → Project Settings. Leave blank to disable
# analytics entirely (the SDK never initialises and every call no-ops).
# IMPORTANT: use the SAME PostHog project that OpenRouter Broadcast points at,
# otherwise UI events and LLM cost events land in two separate projects and
# can't be joined.
NEXT_PUBLIC_POSTHOG_KEY=

# Where the browser sends events. Keep this as /ingest: next.config.mjs rewrites
# it to PostHog so requests stay same-origin and survive ad blockers.
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# Used only for the "view in PostHog" links the SDK generates in the toolbar.
# EU projects: https://eu.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Server-side rewrite targets. Change both to the EU pair for an EU project:
#   POSTHOG_INGEST_HOST=https://eu.i.posthog.com
#   POSTHOG_ASSET_HOST=https://eu-assets.i.posthog.com
POSTHOG_INGEST_HOST=https://us.i.posthog.com
POSTHOG_ASSET_HOST=https://us-assets.i.posthog.com
